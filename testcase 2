import java.math.BigInteger;

public class LagrangeBigConstant {

    static BigInteger lagrange(BigInteger[] x, BigInteger[] y, int k) {
        BigInteger result = BigInteger.ZERO;

        for (int i = 0; i < k; i++) {
            BigInteger term = y[i];

            for (int j = 0; j < k; j++) {
                if (i != j) {
                    BigInteger numerator = x[j].negate(); // (0 - xj)
                    BigInteger denominator = x[i].subtract(x[j]);
                    term = term.multiply(numerator).divide(denominator);
                }
            }
            result = result.add(term);
        }
        return result;
    }

    public static void main(String[] args) {

        BigInteger[] x = {
            BigInteger.ONE,
            BigInteger.valueOf(2),
            BigInteger.valueOf(3),
            BigInteger.valueOf(4),
            BigInteger.valueOf(5),
            BigInteger.valueOf(6),
            BigInteger.valueOf(7)
        };

        BigInteger[] y = {
            new BigInteger("995085094601491"),
            new BigInteger("320923294898495900"),
            new BigInteger("196563650089608567"),
            new BigInteger("1016509518118225951"),
            new BigInteger("3711974121218449851"),
            new BigInteger("10788619898233492461"),
            new BigInteger("26709394976508342463")
        };

        System.out.println("Constant = " + lagrange(x, y, 7));
    }
}
