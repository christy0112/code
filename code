public class LagrangeConstant {

    static double lagrange(double[] x, double[] y, int k, double xp) {
        double sum = 0;

        for (int i = 0; i < k; i++) {
            double term = y[i];
            for (int j = 0; j < k; j++) {
                if (i != j) {
                    term = term * (xp - x[j]) / (x[i] - x[j]);
                }
            }
            sum += term;
        }
        return sum;
    }

    public static void main(String[] args) {

        // Given points (after base conversion)
        double[] x = {1, 2, 3};
        double[] y = {4, 7, 12};
        int k = 3;

        // Constant term = f(0)
        double c = lagrange(x, y, k, 0);

        System.out.println("Constant term (c) = " + c);
    }
}
