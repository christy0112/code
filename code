import java.io.*;
import java.nio.file.*;
import org.json.*;
import java.util.*;

public class PolynomialLagrange {

    public static void main(String[] args) throws Exception {

        // Read JSON file
        String content = new String(Files.readAllBytes(Paths.get("input.json")));
        JSONObject obj = new JSONObject(content);

        int n = obj.getInt("n");
        int k = obj.getInt("k");

        JSONArray roots = obj.getJSONArray("roots");

        double[] x = new double[k];
        double[] y = new double[k];

        // Take only first k roots
        for (int i = 0; i < k; i++) {
            JSONObject r = roots.getJSONObject(i);
            x[i] = r.getDouble("x");
            y[i] = r.getDouble("y");
        }

        // Compute coefficients
        double[] coeff = lagrangeInterpolation(x, y, k);

        System.out.println("Polynomial coefficients:");
        for (int i = 0; i < coeff.length; i++) {
            System.out.printf("a%d = %.4f\n", i, coeff[i]);
        }
    }

    // Lagrange Interpolation to find polynomial coefficients
    public static double[] lagrangeInterpolation(double[] x, double[] y, int k) {

        double[] coeff = new double[k]; // degree k-1 polynomial

        for (int i = 0; i < k; i++) {
            double[] basis = new double[k];
            basis[0] = 1;

            double denom = 1;

            for (int j = 0; j < k; j++) {
                if (i != j) {
                    denom *= (x[i] - x[j]);

                    // multiply polynomial (x - xj)
                    for (int d = k - 1; d > 0; d--) {
                        basis[d] = basis[d] - basis[d - 1] * x[j];
                    }
                }
            }

            for (int d = 0; d < k; d++) {
                coeff[d] += y[i] * basis[d] / denom;
            }
        }
        return coeff;
    }
}
